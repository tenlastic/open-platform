{
  "$schema": "node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": "fb2676a1-46f6-433b-8d97-92756ca071fe",
    "schematicCollections": ["@angular-eslint/schematics"]
  },
  "newProjectRoot": "applications",
  "projects": {
    "home": {
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "allowedCommonJsDependencies": [
              "@tenlastic/wait",
              "events",
              "jszip",
              "marked",
              "path",
              "spark-md5"
            ],
            "aot": true,
            "assets": ["applications/home/src/favicon.ico", "applications/home/src/assets/"],
            "index": "applications/home/src/index.html",
            "outputPath": {
              "base": "applications/home/dist/angular/"
            },
            "polyfills": [
              "applications/home/src/polyfills.ts"
            ],
            "scripts": [
              "node_modules/marked/lib/marked.js",
              "node_modules/swagger-ui-dist/swagger-ui-bundle.js",
              "node_modules/swagger-ui-dist/swagger-ui-standalone-preset.js"
            ],
            "stylePreprocessorOptions": { "includePaths": ["applications/home/"] },
            "styles": [
              "node_modules/swagger-ui-dist/swagger-ui.css",
              "applications/home/src/assets/scss/index.scss"
            ],
            "tsConfig": "applications/home/tsconfig.app.json",
            "webWorkerTsConfig": "applications/home/tsconfig.worker.json",
            "browser": "applications/home/src/main.ts"
          },
          "configurations": {
            "development": {
              "aot": true,
              "extractLicenses": false,
              "namedChunks": false,
              "optimization": false,
              "sourceMap": true
            },
            "production": {
              "aot": true,
              "budgets": [
                {
                  "maximumError": "10kb",
                  "maximumWarning": "6kb",
                  "type": "anyComponentStyle"
                },
                {
                  "maximumError": "5mb",
                  "maximumWarning": "3mb",
                  "type": "initial"
                }
              ],
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "applications/home/src/environments/environment.ts",
                  "with": "applications/home/src/environments/environment.prod.ts"
                }
              ],
              "namedChunks": false,
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["applications/home/**/*.ts", "applications/home/**/*.html"]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "home:build:development"
            },
            "production": {
              "buildTarget": "home:build:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "assets": ["applications/home/src/favicon.ico", "applications/home/src/assets"],
            "karmaConfig": "applications/home/karma.conf.js",
            "main": "applications/home/src/test.ts",
            "polyfills": ["applications/home/src/polyfills.ts"],
            "scripts": [],
            "styles": ["applications/home/src/assets/scss/index.scss"],
            "tsConfig": "applications/home/tsconfig.spec.json"
          }
        }
      },
      "prefix": "app",
      "projectType": "application",
      "root": "applications/home",
      "schematics": { "@schematics/angular:component": { "style": "scss" } },
      "sourceRoot": "applications/home/src"
    }
  },
  "version": 1,
  "schematics": {
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
