{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "declaration": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "lib": [
      "dom",
      "es2018"
    ],
    "module": "es2020",
    "moduleResolution": "bundler",
    "outDir": "./dist/out-tsc",
    "paths": {
      "@home/*": ["./applications/home/src/*"],
      "@tenlastic/http": [
        "../nodejs/modules/http/src"
      ],
      "@tenlastic/wait": [
        "../nodejs/modules/wait/src"
      ],
      "path": [
        "./node_modules/path-browserify"
      ]
    },
    "resolveJsonModule": true,
    "sourceMap": true,
    "target": "ES2022",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "fullTemplateTypeCheck": true,
    "strictInjectionParameters": true
  }
}
